<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Modelled on the sibling postgresql-demodb-jakarta-data: Jakarta Data over an upstream persistence project,
    parent-less, the Jakarta EE 11 BOM for the APIs and Hibernate's platform BOM for the provider, the entities copied
    from upstream's test sources into each module's src/main. The difference is the shape: upstream
    (sqlserver-samples-persistence) is one module per database, and so is this, each module depending on its
    upstream module only. This pom is both the aggregator and the parent of the three.
    -->
  <groupId>io.github.jinahya</groupId>
  <artifactId>sqlserver-samples-jakarta-data</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>${project.artifactId}</name>
  <description>Jakarta Data for Microsoft SQL Server Sample Databases</description>
  <url>https://github.com/jinahya/${project.artifactId}</url>
  <inceptionYear>2026</inceptionYear>
  <organization>
    <name>Jinahya, Inc.</name>
    <url>https://jinahya.com</url>
  </organization>

  <developers>
    <developer>
      <id>onacit</id>
      <name>Kwon, Jin</name>
      <email>onacit@gmail.com</email>
      <url>https://github.com/onacit</url>
      <roles>
        <role>developer</role>
      </roles>
      <timezone>Asia/Seoul</timezone>
    </developer>
  </developers>

  <modules>
    <module>sqlserver-samples-jakarta-data-adventureworks</module>
    <module>sqlserver-samples-jakarta-data-futonmanufacturing</module>
    <module>sqlserver-samples-jakarta-data-wideworldimporters</module>
  </modules>

  <scm>
    <connection>scm:git:git@github.com:jinahya/${project.artifactId}.git</connection>
    <developerConnection>scm:git:git@github.com:jinahya/${project.artifactId}.git</developerConnection>
    <url>https://github.com/jinahya/${project.artifactId}</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/jinahya/${project.artifactId}/issues</url>
  </issueManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!--
      Upstream compiles its main sources at release 17 and its tests at 25; 17 is therefore the floor for anything
      compiled against its mapped superclasses. Both halves here are 25, as the siblings.
      -->
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>${maven.compiler.source}</maven.compiler.target>
    <maven.compiler.release>${maven.compiler.target}</maven.compiler.release>
    <maven.compiler.testSource>${maven.compiler.source}</maven.compiler.testSource>
    <maven.compiler.testTarget>${maven.compiler.testSource}</maven.compiler.testTarget>
    <maven.compiler.testRelease>${maven.compiler.testSource}</maven.compiler.testRelease>
    <!-- Keep parameter names in the class files, as upstream does: Jakarta Data binds query parameters by name. -->
    <maven.compiler.parameters>true</maven.compiler.parameters>

    <!--
      Jakarta EE 11: Jakarta Data 1.0 and Jakarta Persistence 3.2, which the upstream mappings are written against
      (upstream: jakarta.jakartaee-bom 11.0.0).
      https://central.sonatype.com/artifact/jakarta.platform/jakarta.jakartaee-bom/versions
      -->
    <version.jakarta.jakartaee-bom>11.0.0</version.jakarta.jakartaee-bom>

    <!--
      The one Jakarta Data provider for Java SE: Hibernate Data Repositories, i.e. hibernate-processor generating an
      implementation of every @Repository at compile time, over a StatelessSession of hibernate-core at run time.
      EclipseLink 5.0 has no Jakarta Data, so unlike upstream there are no provider profiles. The version is
      upstream's, so the generated code runs on the ORM whose processor generated upstream's metamodel.
      https://docs.hibernate.org/orm/7.4/repositories/html_single/Hibernate_Data_Repositories.html
      -->
    <version.org.hibernate.orm>7.4.15.Final</version.org.hibernate.orm>

    <!-- Local SNAPSHOT only: `./mvnw -DskipTests install` the sibling checkout to pick up a change there. -->
    <version.sqlserver-samples-persistence>0.0.1-SNAPSHOT</version.sqlserver-samples-persistence>

    <!-- The versions below mirror upstream's pom (version.* properties of the same name); change them in step. -->
    <!-- https://central.sonatype.com/artifact/com.microsoft.sqlserver/mssql-jdbc/versions -->
    <version.com.microsoft.sqlserver>13.6.2.jre11</version.com.microsoft.sqlserver>
    <!-- https://central.sonatype.com/artifact/org.assertj/assertj-core/versions -->
    <version.org.assertj>4.0.0-M1</version.org.assertj>
    <!-- hibernate-validator: 9 / expressly: 6 -->
    <!-- https://central.sonatype.com/artifact/org.glassfish.expressly/expressly/versions -->
    <version.org.glassfish.expressly>6.0.0</version.org.glassfish.expressly>
    <!-- https://central.sonatype.com/artifact/org.glassfish.jaxb/jaxb-runtime/versions -->
    <version.org.glassfish.jaxb>4.0.9</version.org.glassfish.jaxb>
    <!-- https://central.sonatype.com/artifact/org.hibernate.validator/hibernate-validator/versions -->
    <version.org.hibernate.validator>9.1.6.Final</version.org.hibernate.validator>
    <!-- https://central.sonatype.com/artifact/org.junit/junit-bom/versions -->
    <version.org.junit>6.1.3</version.org.junit>
    <!-- https://central.sonatype.com/artifact/org.slf4j/slf4j-bom/versions -->
    <version.org.slf4j>2.0.20</version.org.slf4j>

    <!-- The versions below are this project's own, as the sibling postgresql-demodb-jakarta-data has them. -->
    <!-- https://central.sonatype.com/artifact/ch.qos.logback/logback-classic/versions -->
    <version.ch.qos.logback>1.6.6</version.ch.qos.logback>
    <!-- weld-junit5 (weld-testing) version, not the Weld version; 5.0.x pulls Weld 6 / CDI 4.1 -->
    <!-- https://central.sonatype.com/artifact/org.jboss.weld/weld-junit5/versions -->
    <version.org.jboss.weld>5.0.3.Final</version.org.jboss.weld>
    <!-- https://central.sonatype.com/artifact/org.jspecify/jspecify/versions -->
    <version.org.jspecify>1.0.1</version.org.jspecify>

    <!-- the number of failures after which surefire and failsafe stop; -Dtests.skipAfterFailureCount=0 runs them all -->
    <tests.skipAfterFailureCount>1</tests.skipAfterFailureCount>
    <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-surefire-plugin/versions -->
    <version.maven-surefire>3.6.1</version.maven-surefire>
    <version.maven-failsafe>${version.maven-surefire}</version.maven-failsafe>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        Imported, not inherited: this pom is parent-less. A direct entry below beats an imported one, and an earlier
        import beats a later one: the platform BOM resolves every jakarta.* API, Hibernate's platform BOM everything
        org.hibernate.orm and what it brings.
        -->
      <dependency>
        <groupId>jakarta.platform</groupId>
        <artifactId>jakarta.jakartaee-bom</artifactId>
        <version>${version.jakarta.jakartaee-bom}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.hibernate.orm</groupId>
        <artifactId>hibernate-platform</artifactId>
        <version>${version.org.hibernate.orm}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${version.org.junit}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-bom</artifactId>
        <version>${version.org.slf4j}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- The upstream jars, one per database: the mapped superclasses, their static metamodel, the converter. -->
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>sqlserver-samples-persistence-adventureworks</artifactId>
        <version>${version.sqlserver-samples-persistence}</version>
      </dependency>
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>sqlserver-samples-persistence-futonmanufacturing</artifactId>
        <version>${version.sqlserver-samples-persistence}</version>
      </dependency>
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>sqlserver-samples-persistence-wideworldimporters</artifactId>
        <version>${version.sqlserver-samples-persistence}</version>
      </dependency>

      <dependency>
        <groupId>org.jspecify</groupId>
        <artifactId>jspecify</artifactId>
        <version>${version.org.jspecify}</version>
      </dependency>
      <dependency>
        <groupId>org.hibernate.validator</groupId>
        <artifactId>hibernate-validator</artifactId>
        <version>${version.org.hibernate.validator}</version>
      </dependency>
      <dependency>
        <groupId>org.glassfish.expressly</groupId>
        <artifactId>expressly</artifactId>
        <version>${version.org.glassfish.expressly}</version>
      </dependency>
      <dependency>
        <groupId>org.glassfish.jaxb</groupId>
        <artifactId>jaxb-runtime</artifactId>
        <version>${version.org.glassfish.jaxb}</version>
      </dependency>
      <dependency>
        <groupId>org.jboss.weld</groupId>
        <artifactId>weld-junit5</artifactId>
        <version>${version.org.jboss.weld}</version>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${version.org.assertj}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${version.ch.qos.logback}</version>
      </dependency>
      <dependency>
        <groupId>com.microsoft.sqlserver</groupId>
        <artifactId>mssql-jdbc</artifactId>
        <version>${version.com.microsoft.sqlserver}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    What every module needs besides its upstream module, which each module names itself. Declared here, once, as
    upstream declares its shared test dependencies in its root pom.
    -->
  <dependencies>
    <!--
      main =========================================================================================================
      The APIs the entities and repositories are written in. Provided: a consumer brings its own Jakarta Data,
      Jakarta Persistence and provider. jakarta.annotation-api is for the @Nullable of the copied entities.
      -->
    <dependency>
      <groupId>jakarta.data</groupId>
      <artifactId>jakarta.data-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.persistence</groupId>
      <artifactId>jakarta.persistence-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      hibernate-processor emits each repository implementation as a CDI bean, @Dependent with an @Inject constructor,
      when it sees these on the classpath; without them, a plain class whose constructor takes the StatelessSession.
      -->
    <dependency>
      <groupId>jakarta.inject</groupId>
      <artifactId>jakarta.inject-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>jakarta.enterprise.cdi-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The generated implementations are written against org.hibernate.StatelessSession. -->
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- @NullMarked on the repository packages; CLASS-retained, so a consumer needs it only to read the nullness. -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- test frameworks ============================================================================================ -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- A CDI container for the tests, which create the generated repositories as an application server would. -->
    <dependency>
      <groupId>org.jboss.weld</groupId>
      <artifactId>weld-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Hibernate Validator, and the EL it needs, to enforce the constraints in the tests. -->
    <dependency>
      <groupId>org.hibernate.validator</groupId>
      <artifactId>hibernate-validator</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.glassfish.expressly</groupId>
      <artifactId>expressly</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- test runtime =============================================================================================== -->
    <!-- The driver for the SQL Server upstream's _compose.sh brings up; test scope, so consumers do not get it. -->
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-compiler-plugin/versions -->
          <version>3.16.0</version>
          <!--
            Hibernate-processor on the processor path of both executions, default-compile and default-testCompile. It
            generates the static metamodel of the entities of the main sources (each extending upstream's Mapped*_)
            and implements every @Repository interface as a <Name>_ class, both under
            target/generated-sources/annotations. The <path> takes its version from dependencyManagement
            (annotationProcessorPathsUseDepMgmt), so the processor and the hibernate-core it generates against stay
            in step.
            -->
          <configuration>
            <annotationProcessorPathsUseDepMgmt>true</annotationProcessorPathsUseDepMgmt>
            <annotationProcessorPaths>
              <path>
                <groupId>org.hibernate.orm</groupId>
                <artifactId>hibernate-processor</artifactId>
              </path>
            </annotationProcessorPaths>
            <compilerArgs>
              <arg>-Xlint</arg>
              <!--
                The processor also writes a Jakarta Data metamodel per entity (_Customer, ...), each extending the one
                of its mapped superclass (_MappedCustomer), which upstream, compiled without jakarta.data, never
                generated. The repositories are generated against the Jakarta Persistence metamodel, so that second
                metamodel is left out.
                -->
              <arg>-AsuppressJakartaDataMetamodel=true</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-enforcer-plugin/versions -->
          <version>3.6.3</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${version.maven-surefire}</version>
          <configuration>
            <skipAfterFailureCount>${tests.skipAfterFailureCount}</skipAfterFailureCount>
            <trimStackTrace>false</trimStackTrace>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${version.maven-failsafe}</version>
          <configuration>
            <includes>
              <include>**/*IT.java</include>
            </includes>
            <skipAfterFailureCount>${tests.skipAfterFailureCount}</skipAfterFailureCount>
            <trimStackTrace>false</trimStackTrace>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!--
        Dependency convergence is a build defect, not a warning, as upstream treats it. Resolve jakarta.* at the
        platform level (the BOMs above) instead of pinning individual API artifacts.
        -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-dependency-convergence</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <dependencyConvergence/>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>enforce-require-java-version</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <!--
              A -P naming a profile that does not exist is silently ignored by Maven; this turns that into a build
              failure, so that a script naming a renamed profile does not skip the ITs and look green.
              -->
            <id>enforce-require-profile-ids-exist</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireProfileIdsExist/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Binds maven-failsafe-plugin, which runs the *IT classes against the SQL Server upstream's _compose.sh brings up.
      A profile, as upstream, so that a plain `mvnw verify` needs no database.
      -->
    <profile>
      <id>failsafe</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
